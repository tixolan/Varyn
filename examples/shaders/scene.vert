#version 450
// Default vertex shader: transforms a mesh into the camera's view.

#include <varyn.glsl>      // generated by Varyn: uniforms, textures, vertex inputs
#include "surface.glsl"    // found through [shaders].include_dirs

void main() {
    vec4 world = modelMatrix * vec4(inPosition, 1.0);

    vWorldPosition = world.xyz;
    vNormal = mat3(transpose(inverse(modelMatrix))) * inNormal;
    vUV = inUV;

    gl_Position = viewProjection * world;
}
